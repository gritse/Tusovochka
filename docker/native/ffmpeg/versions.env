# Versions of ffmpeg and the codec libraries built into it. Sourced by build.sh.
# The renovate comments tell Renovate where each one is released (see renovate.json); keep each above its line.

# Release tarballs are checked against the FFmpeg release signing key in ffmpeg-devel.asc
# renovate: datasource=github-tags depName=FFmpeg/FFmpeg extractVersion=^n(?<version>\d+\.\d+(\.\d+)?)$
VERSION_FFMPEG=9.0.2
# renovate: datasource=gitlab-tags depName=videolan/dav1d registryUrl=https://code.videolan.org
VERSION_DAV1D=1.5.4
# x264 makes no releases; this is a commit on its stable branch
# renovate: datasource=git-refs depName=x264 packageName=https://code.videolan.org/videolan/x264.git branch=stable
VERSION_X264=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
