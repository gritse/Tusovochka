# Versions of libvips and everything linked into it. Sourced by build.sh.
# Kept in step with https://github.com/lovell/sharp-libvips/blob/main/versions.properties, which bumps these within days
# of each upstream release. VERSION_DE265 is ours: sharp-libvips does not decode HEIC.
# The renovate comments tell Renovate where each one is released (see renovate.json); keep each above its line.

# renovate: datasource=github-releases depName=libvips/libvips extractVersion=^v(?<version>.+)$
VERSION_VIPS=8.18.7

# renovate: datasource=git-tags depName=aom packageName=https://aomedia.googlesource.com/aom extractVersion=^v(?<version>\d+\.\d+\.\d+)$
VERSION_AOM=3.15.3
# renovate: datasource=github-releases depName=libarchive/libarchive extractVersion=^v(?<version>.+)$
VERSION_ARCHIVE=3.8.11
# renovate: datasource=github-releases depName=dloebl/cgif extractVersion=^v(?<version>.+)$
VERSION_CGIF=0.5.4
# renovate: datasource=github-releases depName=strukturag/libde265 extractVersion=^v(?<version>.+)$
VERSION_DE265=1.1.3
# renovate: datasource=github-releases depName=libexif/libexif extractVersion=^v(?<version>.+)$
VERSION_EXIF=0.6.26
# The release tag rather than the version, which Renovate could not convert: expat tags R_2_9_0 for 2.9.0
# renovate: datasource=github-releases depName=libexpat/libexpat versioning=regex:^R_(?<major>\d+)_(?<minor>\d+)_(?<patch>\d+)$
VERSION_EXPAT=R_2_9_0
# renovate: datasource=github-releases depName=libffi/libffi extractVersion=^v(?<version>.+)$
VERSION_FFI=3.8.0
# renovate: datasource=gitlab-tags depName=GNOME/glib registryUrl=https://gitlab.gnome.org
VERSION_GLIB=2.90.1
# renovate: datasource=github-releases depName=strukturag/libheif extractVersion=^v(?<version>.+)$
VERSION_HEIF=1.23.7
# renovate: datasource=github-releases depName=google/highway
VERSION_HIGHWAY=1.4.0
# renovate: datasource=github-tags depName=lovell/libimagequant extractVersion=^v(?<version>.+)$
VERSION_IMAGEQUANT=2.4.1
# renovate: datasource=github-releases depName=mm2/Little-CMS extractVersion=^lcms(?<version>\d+\.\d+(\.\d+)?)$
VERSION_LCMS=2.20
# mozjpeg has had no release since 4.1.5, so like sharp-libvips we pin a commit on master
# renovate: datasource=git-refs depName=mozjpeg packageName=https://github.com/mozilla/mozjpeg branch=master
VERSION_MOZJPEG=08265790774cd0714832c9e675522acbe5581437
# renovate: datasource=github-tags depName=pnggroup/libpng extractVersion=^v(?<version>\d+\.\d+\.\d+)$
VERSION_PNG=1.6.59
# renovate: datasource=github-tags depName=webmproject/libwebp extractVersion=^v(?<version>\d+\.\d+\.\d+)$
VERSION_WEBP=1.6.0
# renovate: datasource=github-releases depName=zlib-ng/zlib-ng
VERSION_ZLIB_NG=2.3.3
